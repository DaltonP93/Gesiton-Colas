{
  "name": "@gc/api",
  "version": "3.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/lib-storage": "^3.1143.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@gc/shared": "*",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "facturacionelectronicapy-xmlgen": "^1.0.283",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "socket.io": "^4.8.4",
    "ssh2": "^1.17.0",
    "xml-crypto": "^6.3.2",
    "xml2js": "^0.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
