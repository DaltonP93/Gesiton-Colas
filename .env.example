# ---------------------------------------------------------------
# Gestión de Colas — variables de entorno
# Copie este archivo a .env y ajuste los valores.
# ---------------------------------------------------------------

# URL pública (se usa en los enlaces de seguimiento y códigos QR)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Base de datos PostgreSQL
DATABASE_URL=postgres://gc:gc@127.0.0.1:5432/gestion_colas
POSTGRES_USER=gc
POSTGRES_PASSWORD=gc
POSTGRES_DB=gestion_colas

# Seguridad: genere un valor largo y aleatorio (p. ej. `openssl rand -hex 32`)
JWT_SECRET=cambie-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos (CORS) separados por coma. * = todos.
CORS_ORIGINS=*

# SaaS: permitir que nuevas organizaciones se registren solas
ALLOW_SIGNUP=true
# Demo por correo: crea una organización de ejemplo que vence a los DEMO_DAYS días
ALLOW_DEMO=true
DEMO_DAYS=14
# Verificación del correo al registrarse: required | optional | off
EMAIL_VERIFICATION=optional

# Correo (verificación, olvidé mi contraseña, acceso por código, invitaciones, demos).
# Sin SMTP los correos solo se muestran en el log del servidor.
# Opción 1: URL completa, p. ej. smtps://usuario:clave@smtp.gmail.com:465
SMTP_URL=
# Opción 2: datos separados
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gestión de Colas <no-reply@su-dominio.com>

# Superadministrador de la plataforma (se crea al iniciar si no existe)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Archivos subidos (videos, imágenes): local o s3 (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces...)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=1024
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Webhooks hacia IPs privadas (solo instalaciones on-premise en red local)
WEBHOOKS_ALLOW_PRIVATE=false

LOG_LEVEL=info
