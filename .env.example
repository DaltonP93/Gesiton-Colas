# ---------------------------------------------------------------
# Gestión de Colas — variables de entorno
# Copie este archivo a .env y ajuste los valores.
# ---------------------------------------------------------------

# URL pública (se usa en los enlaces de seguimiento y códigos QR)
PUBLIC_URL=http://localhost:3000
# Puerto de la aplicación. Con Docker es el puerto publicado en el servidor (p. ej. 80).
PORT=3000

# Base de datos PostgreSQL
DATABASE_URL=postgres://gc:gc@127.0.0.1:5432/gestion_colas
POSTGRES_USER=gc
POSTGRES_PASSWORD=gc
POSTGRES_DB=gestion_colas

# Seguridad: genere un valor largo y aleatorio (p. ej. `openssl rand -hex 32`)
JWT_SECRET=cambie-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos (CORS) separados por coma. * = todos.
# Solo si la app está detrás de un proxy (Nginx, Caddy, Traefik, Cloudflare): cantidad de saltos
# (p. ej. 1) o IPs del proxy. Vacío = la app recibe las conexiones directamente (lo más seguro).
# Mal configurado permite falsificar la IP del cliente y evadir los límites de intentos.
TRUST_PROXY=
CORS_ORIGINS=*

# SaaS: permitir que nuevas organizaciones se registren solas
ALLOW_SIGNUP=true
# Demo por correo: crea una organización de ejemplo que vence a los DEMO_DAYS días
ALLOW_DEMO=true
DEMO_DAYS=14
# Verificación del correo al registrarse: required | optional | off
EMAIL_VERIFICATION=optional

# Correo (verificación, olvidé mi contraseña, acceso por código, invitaciones, demos).
# Lo más simple es configurarlo desde el panel: Plataforma → Ajustes → Correo saliente
# (y cada organización puede usar el suyo). Estas variables quedan como alternativa.
# Sin ningún SMTP los correos solo se muestran en el log del servidor.
# Opción 1: URL completa, p. ej. smtps://usuario:clave@smtp.gmail.com:465
SMTP_URL=
# Opción 2: datos separados
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gestión de Colas <no-reply@su-dominio.com>

# Primer superadministrador (se crea al iniciar solo si todavía no hay ninguno).
# Después se administran en Plataforma → Superadministradores.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Archivos subidos (videos, imágenes): local o s3 (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces...)
STORAGE_DRIVER=local
# Solo sin Docker: con Docker los archivos se guardan en el volumen `uploads`.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=1024
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Webhooks, SMTP y avisos (WAHA / SMS) de cada organización hacia IPs privadas.
# Déjelo en false si varias organizaciones comparten el servidor. En una instalación propia con
# WAHA u otro servicio en la red local (p. ej. http://10.0.0.5:3000), póngalo en true o configure
# ese servicio como proveedor de la plataforma (el superadministrador sí puede usar la red interna).
WEBHOOKS_ALLOW_PRIVATE=false

LOG_LEVEL=info
